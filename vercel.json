{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": {
    "api/create-order.ts": {
      "maxDuration": 20
    },
    "api/verify-payment.ts": {
      "maxDuration": 20
    },
    "api/notify-order.ts": {
      "maxDuration": 20
    },
    "api/broadcast.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/catalog/products.json",
      "destination": "https://pub-10e1205bf35b448b8c1d7a4847ed3d0a.r2.dev/catalog/products.json"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Embedly|vkShare).*"
        }
      ],
      "destination": "/api/media?og=product&id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
